# Env layout (all real files are gitignored):
#
#   .env.local               NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY   (dev + prod builds)
#   .env.development.local   NEXT_PUBLIC_SITE_URL=http://localhost:3000                (npm run dev)
#   .env.production.local    NEXT_PUBLIC_SITE_URL=https://your-live-domain            (npm run deploy)
#   .dev.vars                SUPABASE_SERVICE_ROLE_KEY=...                            (local secret)
#
# Never put the service role key in a .env* file: OpenNext bundles those into the Worker.
# In production it is a Worker secret:  npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
