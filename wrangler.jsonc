/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "merkadoph-opennext",
	// Custom entry: wraps the OpenNext worker and adds the cron (scheduled) handler.
	"main": "cloudflare-worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name.
			// Used by the ISR queue and by the cron handler to call /api/cron/keepalive.
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "merkadoph-opennext"
		}
	],
	// Page/data cache (ISR + unstable_cache). See open-next.config.ts.
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "b8ab751db2df44bbb36af9e9eeb834fe"
		}
	],
	// Media library (2026-11-27): images and videos, served publicly at https://media.merkadoph.se (the bucket's custom
	// domain), written by the admin through this binding (src/lib/media.ts). Moved off Supabase Storage to stay within
	// its Free bandwidth cap; R2 has no egress fees. `remote`: `next dev` uses the real bucket, as it used real Storage.
	"r2_buckets": [
		{ "binding": "MEDIA", "bucket_name": "merkadoph-media", "remote": true }
	],
	// Cache tags for on-demand purges (revalidateTag / revalidatePath). Table is created by `opennextjs-cloudflare deploy`.
	"d1_databases": [
		{
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "merkadoph-next-tag-cache",
			"database_id": "1974e60a-64d9-4e8d-9a26-264edceec683"
		}
	],
	// Rate limiting (security.md §6) — Cloudflare Workers Rate Limiting API, used by src/lib/rate-limit.ts.
	// Limits are per key (IP + action, or email), per Cloudflare location.
	"ratelimits": [
		{ "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
		{ "name": "RL_FORMS", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
		{ "name": "RL_CART", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
	],
	// Supabase keep-alive: 03:00 UTC (11:00 PH) every Monday and Thursday. Keep in sync with src/lib/keepalive.ts.
	"triggers": {
		"crons": ["0 3 * * 1,4", "*/15 * * * *"]
	},
	"observability": {
		"enabled": true,
		// Workers Observability → Issues (open beta): groups uncaught exceptions, failed invocations, 5xx and
		// logged errors. Must stay true here, or the next `wrangler deploy` turns Issues off again.
		"issues": { "enabled": true }
	},
	"upload_source_maps": true,
	// Where the Worker is served (2026-11-21, B12). Only the custom domains below; the workers.dev URL is off.
	// Keep this list identical to Settings → Domains & Routes in the dashboard: on deploy, Wrangler replaces the
	// Worker's custom domains with exactly this list, so a domain missing here would be detached (and its DNS
	// record removed). www stays attached so its DNS record keeps existing; the zone's Redirect Rule
	// (www → merkadoph.se, 301) answers www before the Worker runs.
	// In Workers Builds (non-TTY) this runs without a prompt and overrides conflicting DNS records and other
	// Workers' claims on these hostnames. Add or remove domains here first, never only in the dashboard.
	// Rollback: see local/guidelines.md §3 (Deploys).
	"routes": [
		{ "pattern": "merkadoph.se", "custom_domain": true },
		{ "pattern": "www.merkadoph.se", "custom_domain": true }
	],
	// Off: merkadoph-opennext.<subdomain>.workers.dev served the whole site as a second origin (B12).
	// Keep explicit: Wrangler turns workers.dev on whenever `routes` is empty (e.g. if the routes block is
	// removed or reverted).
	"workers_dev": false,
	// On (kept as today): Version/Preview URLs for Workers Builds preview builds of non-production branches
	// such as `main`. They are separate from the workers.dev route above and keep working when it's off.
	// They are public by default: workers.dev hosts serving the full site with production data (KV, D1,
	// Supabase). Protect them with Cloudflare Access if they shouldn't be (see STATUS "To do").
	"preview_urls": true
	/**
	 * Secrets (set with `npx wrangler secret put NAME`, never committed):
	 * - SUPABASE_SERVICE_ROLE_KEY
	 * - CRON_SECRET
	 * - STAGE_KEY            (preview key for the gated public site, see src/lib/stage.ts)
	 * - RECAPTCHA_SECRET_KEY (reCAPTCHA v3 server verification; the site key is NEXT_PUBLIC_RECAPTCHA_SITE_KEY in .env.production)
	 * - RESEND_API_KEY (transactional email via Resend; without it emails are only logged)
	 * - SETTINGS_ENCRYPTION_KEY (encrypts payment gateway keys in the database, see src/lib/secret-box.ts — never rotate without re-entering the keys)
	 */
}
